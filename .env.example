# Copy to .env. All values are optional unless the feature is used.

# --- codex CLI executor -------------------------------------------------
# Model passed as `codex exec -m` (default gpt-6-luna). It must be available to
# your codex login; `npm run doctor` checks it with one tiny call.
CODEX_MODEL=gpt-6-luna
# Stronger model for red-team rebuttals and synthesis (falls back to CODEX_MODEL).
CODEX_JUDGE_MODEL=
# Reasoning effort passed as -c model_reasoning_effort (low|medium|high|xhigh|max);
# managed = never sent, for providers that fix it (self-hosted, BYOK).
CODEX_EFFORT=medium
# 1 = load ~/.codex/config.toml (plugins, MCP servers, profiles). Default 0:
# workers start lean (~6k fewer input tokens per call) with auth from CODEX_HOME.
CODEX_USE_USER_CONFIG=0
# Optional codex profile (-p); only honoured when CODEX_USE_USER_CONFIG=1.
CODEX_PROFILE=
# Per-call timeout in ms (default 30 min).
CODEX_TIMEOUT_MS=1800000
# 1 (default) = pass a strict JSON schema via --output-schema (structured outputs).
# Removes JSON syntax errors; verified to keep tool use working with codex 0.147.
# Set 0 for providers that reject structured outputs.
CODEX_OUTPUT_SCHEMA=1

# Language of prose fields (titles, explanations, given/when/then). Quotes stay verbatim.
ARW_OUTPUT_LANGUAGE=English

# --- review driver ------------------------------------------------------
ARW_WORKERS=4
ARW_REPAIR_ATTEMPTS=2
ARW_MAX_429_RETRIES=3

# --- Jira (ticket intake) -----------------------------------------------
# Server/DC: JIRA_PAT (Bearer). Cloud: JIRA_EMAIL + JIRA_API_TOKEN (Basic).
JIRA_URL=
JIRA_PAT=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Confluence (pages linked from the ticket or mentioning its key) ---------
# Server/DC: CONFLUENCE_PAT. Cloud: reuses JIRA_EMAIL + JIRA_API_TOKEN unless set.
CONFLUENCE_URL=
CONFLUENCE_PAT=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# 0 = only linked pages, no search by ticket key.
ARW_CONFLUENCE_SEARCH=1

# --- repro tests (RED/GREEN) ----------------------------------------------
# Blocking findings get a model-written test that the harness runs twice on the
# reviewed head (and once with the suggested fix) in a separate worktree.
# The tests execute PR code on this machine, as any build would: use
# `arw review --no-repro` for repositories you do not trust.
REPRO_TIMEOUT_MS=900000
# 1 = mvn -o (use only the local repository).
REPRO_MAVEN_OFFLINE=0
# Windows sandbox mode for codex >= 0.162 when user config is ignored.
CODEX_WINDOWS_SANDBOX=unelevated

# --- autonomy ---------------------------------------------------------------
# 1 = a deterministic policy approves a SPEC with no gaps, no contradictions and
# no inferred rules. Never after a human rejection. Reviews still need a person.
ARW_AUTO_APPROVE_SPEC=0

# --- GitHub -------------------------------------------------------------
# gh CLI auth is used. Map repos to local checkouts in config/repos.json.
