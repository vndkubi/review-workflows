{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arw/analysis.schema.json",
  "title": "Read-only investigation of approved review items against a repository (ticket pipeline)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticket", "items", "questions", "impacted", "options", "acceptance_tests"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ticket": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "current", "status", "label", "evidence"],
        "properties": {
          "item": { "$ref": "#/$defs/itemId" },
          "current": { "$ref": "#/$defs/text" },
          "status": { "enum": ["matches", "differs", "not_implemented", "unknown"] },
          "label": { "$ref": "#/$defs/label" },
          "evidence": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "why", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
          "question": { "$ref": "#/$defs/text" },
          "why": { "$ref": "#/$defs/text" },
          "blocks": { "type": "array", "items": { "$ref": "#/$defs/itemId" } }
        }
      }
    },
    "impacted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "label"],
        "properties": {
          "path": { "$ref": "#/$defs/text" },
          "symbol": { "type": "string" },
          "reason": { "$ref": "#/$defs/text" },
          "label": { "$ref": "#/$defs/label" }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "summary", "tradeoffs"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "summary": { "$ref": "#/$defs/text" },
          "tradeoffs": { "$ref": "#/$defs/text" }
        }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "test"],
        "properties": {
          "item": { "$ref": "#/$defs/itemId" },
          "test": { "$ref": "#/$defs/text" },
          "existing_test": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "itemId": { "type": "string", "pattern": "^I[1-9][0-9]*$" },
    "label": { "enum": ["CONFIRMED", "INFERRED", "UNKNOWN"] },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  }
}
